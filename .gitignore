# =========================
# NutriGuard - Git Ignore
# =========================

# Environment / secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Credentials / certificates
client_secret.json
**/client_secret.json
*.key
*.pem
*.p12
*.pfx

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Database
*.db
*.sqlite
*.sqlite3

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Android / Gradle
.gradle/
build/
*/build/
local.properties
*.iml
.idea/
.externalNativeBuild/
.cxx/

# OS
.DS_Store
Thumbs.db

# Archives / temporary files
*.zip
*.tar
*.tar.gz
*.7z
*.rar
*.bak
*.tmp
*.log

# Large / temporary images
*.jpg
*.jpeg
*.png
*.gif
*.webp

# Local archive / source material
/files/
