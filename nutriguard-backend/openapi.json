    "/api/v1/scan/label-image": {
      "post": {
        "tags": [
          "scan"
        ],
        "summary": "Scan Label Image",
        "description": "API Contract 6.3, extended with an optional multipart `barcode`\nfield: lets a client that already attempted POST /scan/barcode (and\ngot `labelScanRequired`) resubmit the same barcode alongside the\nlabel image, so the backend can combine both sources into one\ncanonical, persisted product instead of a synthetic `img_...` one.\n\n`barcode` omitted, blank, or a literal placeholder (e.g. \"null\",\n\"N/A\") -> behaves EXACTLY as before (`food_analysis.\nanalyze_label_image`), fully backward compatible with existing\nclients. A supplied barcode is validated/canonicalized through the\nsame `barcode_validation` module `/scan/barcode` uses; an invalid\none returns the standard structured `VALIDATION_ERROR` response.",
        "operationId": "scan_label_image_api_v1_scan_label_image_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_scan_label_image_api_v1_scan_label_image_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FullProductAnalysisOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
