# Copy this file to `.env` and fill in real values before running
# `docker compose up` or the app locally. NEVER commit the real `.env`.

# --- General ---
ENVIRONMENT=development

# --- Database ---
# Local dev via docker-compose uses the "db" service hostname.
# Running the app directly on the host, use localhost instead.
DATABASE_URL=postgresql+asyncpg://nutriguard:nutriguard@localhost:5432/nutriguard

# --- Redis (rate limiting + cache) ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# --- Auth / JWT ---
# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=2592000

# --- CORS ---
# Comma-separated list of allowed origins, or "*" for all (dev only).
CORS_ORIGINS=*

# --- Gemini integration ---
# NEVER put this key in the Android client. Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60

# --- Uploads ---
MAX_IMAGE_SIZE_BYTES=8388608

# --- Temporary scan diagnostics (disabled by default) ---
# Writes one compact JSON line per label-image scan. The file rotates at
# 1 MiB and keeps one backup; no image/OCR text/model response is stored.
SCAN_DIAGNOSTICS_ENABLED=false
SCAN_DIAGNOSTICS_PATH=/var/log/nutriguard/scan-diagnostics.jsonl
SCAN_DIAGNOSTICS_MAX_BYTES=1048576
SCAN_DIAGNOSTICS_BACKUP_COUNT=1

# --- Rate limiting ---
RATE_LIMIT_SCAN_PER_HOUR=30
RATE_LIMIT_READ_PER_HOUR=300
RATE_LIMIT_PROFILE_PER_HOUR=60
RATE_LIMIT_AUTH_PER_MINUTE=10

# --- Seeding ---
# When true, the container entrypoint (re)loads the scientific ingredient
# seed data on every start. Safe to leave on (idempotent upsert).
SEED_ON_START=true

# --- Barcode product discovery ---
# Multi-source lookup used only when a scanned barcode isn't already in
# the local `products` table. Every provider is optional and the backend
# starts and works fine with all of them left at these defaults (no
# credentials required for Open Food Facts, GS1, or UPCitemdb's free
# trial tier). Set BARCODE_DISCOVERY_ENABLED=false to disable external
# lookups entirely and always fall through to the "label scan required"
# response on a local miss.
BARCODE_DISCOVERY_ENABLED=true

OPEN_FOOD_FACTS_ENABLED=true
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
# OFF asks integrators to identify their app in the User-Agent; keep this
# descriptive if you fork/deploy under a different name.
OPEN_FOOD_FACTS_USER_AGENT=NutriGuard-Backend/1.0 (+https://github.com/nikoit2022-creator/NutriGuard)

GS1_RESOLVER_ENABLED=true
# GS1's own public Digital Link resolver. Used only to look up an
# official manufacturer/GS1-registered resource link for a GTIN, never
# as a general product database.
GS1_RESOLVER_BASE_URL=https://id.gs1.org

UPCITEMDB_ENABLED=true
# Free, no-credentials "trial" host by default (rate limited by
# UPCitemdb, ~100 requests/day/IP). For a paid plan, point this at your
# prod/v1 host and set the key(s) below; leave both blank to keep using
# the trial tier.
UPCITEMDB_BASE_URL=https://api.upcitemdb.com/prod/trial
UPCITEMDB_API_KEY=
UPCITEMDB_USER_KEY=

# Connect/read timeout applied to every barcode provider call.
BARCODE_PROVIDER_TIMEOUT_SECONDS=5
# Extra attempts (beyond the first) on a timeout/network/5xx error from a
# single provider before moving on to the next one.
BARCODE_PROVIDER_MAX_RETRIES=1
# How long an externally discovered (unverified) product is considered
# fresh before it becomes eligible to be re-verified from providers again.
BARCODE_DISCOVERY_CACHE_SECONDS=2592000
